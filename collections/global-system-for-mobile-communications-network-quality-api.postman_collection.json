                  "disabled": false,
                  "description": "Correlation id for the different services",
                  "key": "x-correlator",
                  "value": "string"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"packetDelayBudget\": \"meets the application requirements\",\n  \"targetMinDownstreamRate\": \"meets the application requirements\",\n  \"targetMinUpstreamRate\": \"unable to meet the application requirements\",\n  \"packetlossErrorRate\": \"meets the application requirements\",\n  \"jitter\": \"meets the application requirements\",\n  \"additionalKPIs\": {\n    \"signalStrength\": \"no signal\",\n    \"connectivityType\": \"4G\"\n  }\n}",
